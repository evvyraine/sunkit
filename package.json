{
  "name": "sunkit-ui",
  "version": "0.2.0-alpha.0",
  "description": "Sunkit — pastel React component library",
  "type": "module",
  "license": "MIT",
  "author": "Sunkit contributors",
  "homepage": "https://evvyraine.github.io/sunkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evvyraine/sunkit.git"
  },
  "bugs": {
    "url": "https://github.com/evvyraine/sunkit/issues"
  },
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "ui",
    "pastel",
    "tailwindcss",
    "storybook",
    "web-audio",
    "sound"
  ],
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/sunkit.cjs",
  "module": "dist/sunkit.js",
  "types": "dist/index.d.ts",
  "style": "dist/sunkit.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sunkit.js",
      "require": "./dist/sunkit.cjs"
    },
    "./sunkit.css": "./dist/sunkit.css",
    "./dist/sunkit.css": "./dist/sunkit.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "bash scripts/screenshots.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish --tag alpha",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^9.26.0",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "^0.2.2",
    "eslint": "^9.26.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^10.3.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.32.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.1.2"
  }
}
